# Copy to deploy/.env, which git ignores, and fill in the values.
# docs/guides/local-stack.md explains each one.

# Development passwords (compose.dev.yaml). Compose refuses to start while
# they are empty. Neo4j needs 8 characters or more.
NEO4J_PASSWORD=
POSTGRES_PASSWORD=

# Optional, shown with their defaults.
# POSTGRES_USER=tenetrag
# POSTGRES_DB=tenetrag
# NEO4J_BOLT_PORT=7687
# NEO4J_HTTP_PORT=7474
# POSTGRES_PORT=5432

# Production only (compose.prod.yaml). Passwords live in secret files there.
# TENETRAG_SECRETS_DIR=./secrets
# NEO4J_HEAP_SIZE=1g
# NEO4J_PAGECACHE_SIZE=1g
# NEO4J_MEMORY_LIMIT=3g
# POSTGRES_MEMORY_LIMIT=2g
